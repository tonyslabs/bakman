# Copia este archivo a .env (junto a docker-compose.yml) y rellénalo.

# --- Obligatorio -------------------------------------------------------------------------
# Clave de cifrado. Generar:  docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Guárdala: con ella se cifran las contraseñas de tus conexiones y los tokens de Ajustes.
APP_KEY=

# Tu MySQL 8 / MariaDB 10.6+ (bakman no lo incluye). Crea antes la base y el usuario:
#   CREATE DATABASE backend_manager CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_HOST=
DB_PORT=3306
DB_DATABASE=backend_manager
DB_USERNAME=
DB_PASSWORD=

# Tu Redis 6+ (bakman no lo incluye): cola de jobs, caché y locks del scheduler.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PREFIX=bakman:

# Administrador inicial (se crea una sola vez, si no hay usuarios).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Opcional ---------------------------------------------------------------------------
# IP en la que se publica el puerto. 127.0.0.1 = solo esta máquina. Usa una IP privada (LAN/VPN);
# nunca 0.0.0.0 sin HTTPS delante: quien entre al panel puede ejecutar comandos en tus servidores.
BAKMAN_BIND=127.0.0.1
BAKMAN_PORT=8091
APP_URL=http://localhost:8091
APP_LOCALE=es
TZ=UTC

# Carpetas del host para backups y logs de scripts.
BACKUPS_DIR=./data/backups
LOGS_DIR=./data/logs

# También configurables después desde Ajustes en la web.
PORTAINER_URL=http://portainer:9000
PORTAINER_TOKEN=
NTFY_URL=
NTFY_TOKEN=
